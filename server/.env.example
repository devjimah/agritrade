PORT=5000
MONGODB_URI=mongodb://localhost:27017/agritrade
JWT_SECRET=replace-with-64-random-bytes-hex
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
# Set to true when running behind a reverse proxy (Render/Railway/nginx)
TRUST_PROXY=false
# Optional overrides for the seed script (npm run seed)
SEED_ADMIN_EMAIL=admin@agritrade.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- AI layer (Meta Model API) ---
META_MODEL_API_KEY=
# Recommended text+image model with tool calling (dev.meta.ai/docs/models)
META_MODEL=muse-spark-1.3
# META_API_BASE_URL=https://api.meta.ai/v1
